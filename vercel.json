{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/artiklar", "destination": "/api/artikel" },
    { "source": "/artiklar/:slug", "destination": "/api/artikel?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
